# ── Yggdrasil — variáveis compartilhadas (referência) ────────
# Não duplicar entre serviços. Cada serviço tem .env.example próprio
# com as var específicas dele. As de infra compartilhada ficam aqui.
# Copie para .env local. NUNCA commitar .env.

# Postgres
POSTGRES_USER=ygg
POSTGRES_PASSWORD=changeme
POSTGRES_DB=yggdrasil
POSTGRES_PORT=5432

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Streams do contrato de eventos (ADR-005)
REDIS_STREAM_INGEST=events:ingest:raw
REDIS_STREAM_NORMALIZED=events:ingest:normalized
REDIS_CONSUMER_GROUP=huginn

# Observabilidade (Langfuse)
LANGFUSE_HOST=http://127.0.0.1:4000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# LLM gateway (LiteLLM)
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_API_KEY=sk-local

# ygg-api
YGG_API_PORT=8080