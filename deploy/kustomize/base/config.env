# Config NÃO secreta do cluster (ConfigMap yggdrasil-config, via envFrom).
# Segredos (URLs com credencial, API keys) ficam no Secret yggdrasil-secrets,
# criado fora do kustomize — ver deploy/kustomize/secrets.example.yaml.

# huginn — streams do contrato de eventos (ADR-005)
REDIS_STREAM_INGEST=events:ingest:raw
REDIS_STREAM_NORMALIZED=events:ingest:normalized
REDIS_CONSUMER_GROUP=huginn
RUST_LOG=info

# ygg-api (Service muninn expõe a porta 80)
MUNNIN_URL=http://muninn
# Qualquer valor diferente de "development" recusa o JWT_SECRET de dev.
ENV=production

# muninn (pydantic-settings lê apenas o prefixo MUNNIN_)
MUNNIN_MODEL=gpt-4o-mini
MUNNIN_LITELLM_BASE_URL=http://litellm:4000
MUNNIN_LANGFUSE_HOST=http://langfuse:3000
MUNNIN_YGG_API_URL=http://ygg-api
# Mesmo valor de REDIS_STREAM_NORMALIZED (ADR-005); group "muninn" é o default.
MUNNIN_REDIS_STREAM_NORMALIZED=events:ingest:normalized
