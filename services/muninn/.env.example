# muninn — variáveis de ambiente (prefixo MUNNIN_)
MUNNIN_PORT=8090

# Gateway LLM (LiteLLM)
MUNNIN_LITELLM_BASE_URL=http://127.0.0.1:4000
MUNNIN_LITELLM_API_KEY=sk-local
MUNNIN_MODEL=gpt-4o-mini

# Observabilidade (Langfuse)
MUNNIN_LANGFUSE_HOST=http://127.0.0.1:4000
MUNNIN_LANGFUSE_PUBLIC_KEY=
MUNNIN_LANGFUSE_SECRET_KEY=

# Backend de orquestração
MUNNIN_YGG_API_URL=http://127.0.0.1:8080