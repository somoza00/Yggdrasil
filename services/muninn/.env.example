# muninn — variáveis de ambiente (prefixo MUNNIN_)
MUNNIN_PORT=8090
MUNNIN_LOG_LEVEL=INFO

# Gateway LLM (LiteLLM)
MUNNIN_LITELLM_BASE_URL=http://127.0.0.1:4000
MUNNIN_LITELLM_API_KEY=sk-local
MUNNIN_MODEL=gpt-4o-mini

# Observabilidade (Langfuse)
MUNNIN_LANGFUSE_HOST=http://127.0.0.1:4000
MUNNIN_LANGFUSE_PUBLIC_KEY=
MUNNIN_LANGFUSE_SECRET_KEY=

# Backend de orquestração
MUNNIN_YGG_API_URL=http://127.0.0.1:8080
# JWT de serviço (Bearer) do POST /api/v1/incidents. Sem prefixo MUNNIN_.
# Emitir: cd services/ygg-api && JWT_SECRET=... go run ./cmd/ygg-token -sub muninn
YGG_API_SERVICE_TOKEN=

# Worker do stream events:ingest:normalized (ADR-005)
MUNNIN_WORKER_ENABLED=true
MUNNIN_REDIS_URL=redis://127.0.0.1:6379
MUNNIN_REDIS_STREAM_NORMALIZED=events:ingest:normalized
# Opcional: nome do consumer no grupo. Default = HOSTNAME (nome do pod em K8s).
# MUNNIN_CONSUMER_NAME=
